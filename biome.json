{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useImportType": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noDoubleEquals": "off",
            "noArrayIndexKey": "warn"
          },
          "style": {
            "noNonNullAssertion": "off"
          },
          "a11y": {
            "noRedundantRoles": "warn",
            "noStaticElementInteractions": "off",
            "noNoninteractiveElementInteractions": "off"
          }
        }
      }
    }
  ],
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.next",
      "!**/.expo",
      "!**/.turbo",
      "!**/ios",
      "!**/android",
      "!**/routeTree.gen.ts",
      "!design",
      "!**/.content-collections"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
