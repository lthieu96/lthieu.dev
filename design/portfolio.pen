                      "type": "text",
                      "id": "v50WGb",
                      "name": "Item 1",
                      "fill": "$prose",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "· Hover a layer: it lifts 2 px, the trace highlights its spans, others dim.",
                      "lineHeight": 1.5,
                      "fontFamily": "$sans",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "TvOzT",
                      "name": "Item 2",
                      "fill": "$prose",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "· Hover a span: the layer it belongs to lights. The two views explain each other.",
                      "lineHeight": 1.5,
                      "fontFamily": "$sans",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "dEKwl",
                      "name": "Item 3",
                      "fill": "$prose",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "· Drag the playhead in the trace to scrub the whole sequence.",
                      "lineHeight": 1.5,
                      "fontFamily": "$sans",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "YayeM",
                      "name": "Item 4",
                      "fill": "$prose",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "· Keyboard: up and down arrows move between layers, Enter expands details.",
