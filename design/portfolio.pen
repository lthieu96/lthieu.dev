    {
      "type": "frame",
      "id": "ixhvw",
      "x": 11936,
      "y": 22400,
      "name": "Work · Research and pick",
      "theme": {
        "mode": "light"
      },
      "width": 760,
      "fill": "$surface-2",
      "layout": "vertical",
      "gap": 28,
      "padding": 56,
      "children": [
        {
          "type": "frame",
          "id": "O7y6k",
          "name": "Header",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "children": [
            {
              "type": "text",
              "id": "qX6E7",
              "name": "Title",
              "fill": "$fg",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Research and pick",
              "lineHeight": "$leading-h1",
              "fontFamily": "$ui",
              "fontSize": "$text-h1",
              "fontWeight": "500"
            },
            {
              "type": "text",
              "id": "HxqKs",
              "name": "Desc",
              "fill": "$muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "What strong personal sites do with a short project list, and which option fits this one.",
              "lineHeight": "$leading-body",
              "fontFamily": "$ui",
              "fontSize": "$text-body",
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "MHhlK",
          "name": "WHAT THE SITES DO",
          "width": "fill_container",
          "fill": "$card",
          "cornerRadius": 12,
          "stroke": "$border",
          "strokeWidth": 1,
          "layout": "vertical",
          "gap": 8,
          "padding": 24,
          "children": [
            {
              "type": "text",
              "id": "AjfJM",
              "name": "H",
              "fill": "$subtle",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "WHAT THE SITES DO",
              "lineHeight": "$leading-meta",
              "fontFamily": "$mono",
              "fontSize": "$text-meta",
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "ntjnh",
              "name": "Item",
              "fill": "$prose",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "emilkowal.ski, paco.me, jakub.kr: 3 to 4 projects, each a title and one line, linking straight to the product or GitHub. No thumbnails, no case-study badge.",
              "lineHeight": "$leading-ui",
              "fontFamily": "$ui",
              "fontSize": "$text-ui",
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "LPeEt",
              "name": "Item",
              "fill": "$prose",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "rauno.me/projects is a plain list with years; the media lives on a separate craft page, where each card says what the link is: View Production, View Prototype, Read Essay.",
              "lineHeight": "$leading-ui",
              "fontFamily": "$ui",
              "fontSize": "$text-ui",
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "mSeZ9",
              "name": "Item",
              "fill": "$prose",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "shud.in makes unwritten work secondary: big projects get a heading and a few lines, small ones are title-only, some not linked at all.",
              "lineHeight": "$leading-ui",
              "fontFamily": "$ui",
              "fontSize": "$text-ui",
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "M7Q8H0",
              "name": "Item",
              "fill": "$prose",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "joshpuckett.me and brianlovin.com mix own write-ups and external links with no visual difference. raphaelsalaja.com is the one media-first site (square thumbnails).",
              "lineHeight": "$leading-ui",
              "fontFamily": "$ui",
              "fontSize": "$text-ui",
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "qLAPx",
              "name": "Item",
              "fill": "$prose",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "None of the minimal sites show a hover preview on the main list. Hover, video and keyboard behaviour could not be checked from text fetches.",
              "lineHeight": "$leading-ui",
              "fontFamily": "$ui",
              "fontSize": "$text-ui",
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "lVTEd",
          "name": "TIMING AND ACCESS",
          "width": "fill_container",
          "fill": "$card",
          "cornerRadius": 12,
          "stroke": "$border",
          "strokeWidth": 1,
          "layout": "vertical",
          "gap": 8,
          "padding": 24,
          "children": [
            {
              "type": "text",
              "id": "KMQg3",
              "name": "H",
              "fill": "$subtle",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "TIMING AND ACCESS",
              "lineHeight": "$leading-meta",
              "fontFamily": "$mono",
              "fontSize": "$text-meta",
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "gB8wV",
              "name": "Item",
              "fill": "$prose",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "NN/g: feedback within 100ms; reveal heavier content only after a 300 to 500ms rest; keep it for about 500ms after the pointer leaves.",
              "lineHeight": "$leading-ui",
              "fontFamily": "$ui",
              "fontSize": "$text-ui",
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "IOShz",
              "name": "Item",
              "fill": "$prose",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "WCAG 1.4.13: content shown on hover must also show on focus, be dismissible, and stay while hovered.",
              "lineHeight": "$leading-ui",
              "fontFamily": "$ui",
              "fontSize": "$text-ui",
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "oMtO6",
              "name": "Item",
              "fill": "$prose",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Hover styles go behind (hover: hover), but hybrid devices misreport it, so touch and keyboard must work on their own.",
              "lineHeight": "$leading-ui",
              "fontFamily": "$ui",
              "fontSize": "$text-ui",
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "x75oMo",
              "name": "Item",
              "fill": "$prose",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Emil Kowalski: UI motion under 300ms, no delay between neighbours once one is open, little or no animation on things seen many times. animations.dev: ease-in-out for things already on screen that change.",
              "lineHeight": "$leading-ui",
              "fontFamily": "$ui",
              "fontSize": "$text-ui",
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "MXUZU",
          "name": "PICK",
          "width": "fill_container",
          "fill": "$card",
          "cornerRadius": 12,
          "stroke": "$border",
          "strokeWidth": 1,
          "layout": "vertical",
          "gap": 8,
          "padding": 24,
          "children": [
            {
              "type": "text",
              "id": "wcA4d",
              "name": "H",
              "fill": "$subtle",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "PICK",
              "lineHeight": "$leading-meta",
              "fontFamily": "$mono",
              "fontSize": "$text-meta",
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "htEcw",
              "name": "Item",
              "fill": "$prose",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "D, Lead and index. It is the closest to the sites you like, it shows real Sway screens instead of logos, it behaves the same on touch, mouse and keyboard, and the projects without a case study simply stay text.",
              "lineHeight": "$leading-ui",
              "fontFamily": "$ui",
              "fontSize": "$text-ui",
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "VrxwH",
              "name": "Item",
              "fill": "$prose",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "If Cerebro needs its picture back, borrow E's detail for the index later, or rotate the lead. C is the cheapest step from today's code if you want to keep the current rows.",
              "lineHeight": "$leading-ui",
              "fontFamily": "$ui",
              "fontSize": "$text-ui",
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "zOwje",
              "name": "Item",
              "fill": "$prose",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Avoid A unless the margin dither goes: the pane and the field fight for the same space.",
              "lineHeight": "$leading-ui",
              "fontFamily": "$ui",
              "fontSize": "$text-ui",
              "fontWeight": "normal"
            }
          ]
        }
      ]
    },
