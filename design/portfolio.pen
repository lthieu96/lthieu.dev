                {
                  "type": "text",
                  "id": "pXIeE",
                  "name": "Body",
                  "fill": "$prose",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A pale tint of the brand colour, with the product's real screens standing in it and running off the bottom. The number and shape of screens says the platform at a glance: three phones for Sway, one browser for Cerebro and BenKon, browser plus phone for GreenMaster Go. No device frames, just the screen with its own corner radius and a hairline.",
                  "lineHeight": 1.55,
                  "fontFamily": "Geist",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "C9kh3n",
              "name": "Production",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 6,
              "children": [
                {
                  "type": "text",
                  "id": "p1Kms",
                  "name": "Label",
                  "fill": "$subtle",
                  "content": "Production",
                  "lineHeight": 1.55,
                  "fontFamily": "Geist",
                  "fontSize": 13,
                  "fontWeight": "500"
                },
                {
                  "type": "text",
                  "id": "OAEDz",
                  "name": "Body",
                  "fill": "$prose",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Same Pencil export as A (2x PNG, cwebp to 512x320). Screens with customer data (BenKon, GreenMaster dashboards) get a blur effect on the image layer before export, so the webp never contains readable text. Keep thumb.invert: true, these are light thumbs.",
                  "lineHeight": 1.55,
                  "fontFamily": "Geist",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "r1n0WP",
              "name": "Pros and cons",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 6,
