              "height": 56
            },
            {
              "type": "text",
              "id": "dQKOJ",
              "name": "The hard problem",
              "fill": "$fg",
              "content": "The hard problem",
              "lineHeight": "$leading-h2",
              "fontFamily": "$ui",
              "fontSize": "$text-h2",
              "fontWeight": "500",
              "letterSpacing": -0.3
            },
            {
              "type": "frame",
              "id": "iprtU",
              "name": "Space",
              "width": 1,
              "height": 12
            },
            {
              "type": "text",
              "id": "ic6W1",
              "name": "Everyone wants the excha",
              "fill": "$prose",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Everyone wants the exchange at once: people trading, the app refreshing prices, background jobs syncing. If one side hogs the budget, trades slow down. So each side gets its own lane, and trading always goes first.",
              "lineHeight": "$leading-body",
