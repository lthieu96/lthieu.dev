                },
                {
                  "type": "text",
                  "id": "FZr0Y",
                  "name": "Body",
                  "fill": "$prose",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "+ Light, quiet, closest to the page. + Shows range: phone, web, both. - Whole screens are mush at 128x80, so the four can still blur together; the tint is doing all the work. - The blurred dashboards look soft next to the crisp Sway and Cerebro screens.",
                  "lineHeight": 1.55,
