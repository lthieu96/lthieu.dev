                  "fontSize": 13,
                  "fontWeight": "500"
                },
                {
                  "type": "text",
                  "id": "l34Fz",
                  "name": "Body",
                  "fill": "$prose",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Drawn in Pencil with real values and colours sampled from the products (pill reds and blues, token colours of the ring, the green of the app). Export 2x PNG, cwebp to 512x320. Because it's vector, it can also be exported as SVG or HTML later and animated (the ring filling, the toggle flipping) if motion is wanted.",
                  "lineHeight": 1.55,
                  "fontFamily": "Geist",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "xPvWh",
