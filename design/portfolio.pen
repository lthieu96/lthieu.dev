                  "fontSize": 13,
                  "fontWeight": "500"
                },
                {
                  "type": "text",
                  "id": "BxLTS",
                  "name": "Body",
                  "fill": "$prose",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "+ Sharpest at 128x80: one big shape per thumb, and it survives the 1 px dither best. + Zero privacy risk. + Says what each product does, not just what it looks like. - A redraw, not the real UI, so it can drift from the product. - Needs a designer's eye per project; easy to slide into icon-illustration land.",
                  "lineHeight": 1.55,
                  "fontFamily": "Geist",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
