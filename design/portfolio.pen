              "height": 12
            },
            {
              "type": "text",
              "id": "V1XRFX",
              "name": "An app that turns crypto",
              "fill": "$muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "An app that turns crypto news into cards. You swipe one, take a side, and it becomes a real trade. I work on the phone app and the servers behind it.",
              "lineHeight": "$leading-body",
              "fontFamily": "$ui",
              "fontSize": "$text-body",
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "Rcwrq",
